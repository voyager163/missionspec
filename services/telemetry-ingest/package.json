{
  "name": "@msn-control/missionspec-telemetry-ingest",
  "version": "0.0.0",
  "private": true,
  "description": "Operator-deployed MissionSpec aggregate telemetry receiver; not a CLI dependency.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "schema:generate": "node scripts/schema.mjs --write",
    "schema:check": "node scripts/schema.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run schema:check && npm run build && node --test tests/*.test.mjs",
    "start": "node --no-turbofan --no-maglev --disable-sigusr1 dist/main.js"
  },
  "dependencies": {
    "@azure/identity": "4.13.3",
    "@azure/logger": "1.3.0",
    "@azure/monitor-ingestion": "1.2.0",
    "@azure/storage-queue": "12.32.0",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@azure/core-rest-pipeline": "1.25.0",
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@azure/storage-queue": {
      "fast-xml-parser": {
        ".": "5.7.0",
        "@nodable/entities": "2.1.0"
      }
    }
  }
}
