{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:missionspec:telemetry-event:1",
  "title": "MissionSpec operation completion aggregate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "event", "operation", "cliVersion", "outcome", "host", "os", "durationBucket"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "event": { "const": "operation-completed" },
    "operation": {
      "enum": ["draft", "draft-all", "implement", "verify", "archive", "revise", "principles", "sync"]
    },
    "cliVersion": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})(-(alpha|beta|rc)\\.(0|[1-9][0-9]{0,5}))?$(?![\\s\\S])"
    },
    "outcome": { "enum": ["completed", "blocked", "failed", "cancelled", "unknown"] },
    "host": { "enum": ["copilot", "codex", "claude", "none", "multiple", "unknown"] },
    "os": { "enum": ["macos", "windows", "linux", "other"] },
    "durationBucket": { "enum": ["under-1s", "1s-to-10s", "10s-to-1m", "1m-to-10m", "10m-to-1h", "1h-or-more", null] }
  }
}
