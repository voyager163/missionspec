# EXAMPLE ONLY. Private state resources are a separate operator prerequisite.
# Copy to ignored backend.hcl only after authorization and replace every placeholder.
resource_group_name  = "REQUIRED_PRIVATE_STATE_RESOURCE_GROUP"
storage_account_name = "REQUIRED_PRIVATE_STATE_ACCOUNT"
container_name       = "REQUIRED_PRIVATE_STATE_CONTAINER"
key                  = "missionspec/telemetry.tfstate"
subscription_id      = "REQUIRED_STATE_SUBSCRIPTION_UUID"
tenant_id            = "REQUIRED_STATE_TENANT_UUID"
client_id            = "REQUIRED_FEDERATED_STATE_PRINCIPAL_UUID"
use_oidc             = true
# No access_key, sas_token, or client_secret. The backend also enforces use_azuread_auth.
